# SEO Intelligence Engine -- example environment configuration.
# Copy to .env and adjust. Every variable is prefixed with SIE_.
# Nested settings use __ as delimiter (e.g. SIE_CRAWLER__MAX_PAGES).

# --- Application -----------------------------------------------------------
# development | test | production
SIE_ENVIRONMENT=development
SIE_DEBUG=true
# DEBUG | INFO | WARNING | ERROR
SIE_LOG_LEVEL=INFO

# --- HTTP server -------------------------------------------------------------
SIE_HOST=127.0.0.1
SIE_PORT=8000

# --- Persistence --------------------------------------------------------------
# SQLite today; Postgres later by changing this URL only.
SIE_DATABASE_URL=sqlite+aiosqlite:///./sie.db

# Run Alembic migrations automatically at startup (recommended for dev).
SIE_AUTO_MIGRATE=true

# --- Crawler defaults (consumed by the Crawler Engine) ------------------------
SIE_CRAWLER__USER_AGENT=Mozilla/5.0 (compatible; SEOIntelligenceEngine/0.1)
SIE_CRAWLER__REQUEST_TIMEOUT_SECONDS=20
SIE_CRAWLER__MAX_CONCURRENT_REQUESTS=10
SIE_CRAWLER__RATE_LIMIT_PER_HOST=1.0
SIE_CRAWLER__RESPECT_ROBOTS_TXT=true
SIE_CRAWLER__FOLLOW_CROSS_ORIGIN=false
SIE_CRAWLER__MAX_PAGES=1000
SIE_CRAWLER__DEPTH_LIMIT=5
SIE_CRAWLER__VISITED_CACHE_SIZE=100000
SIE_CRAWLER__MAX_RETRIES=2
SIE_CRAWLER__RETRY_BACKOFF_SECONDS=0.5
