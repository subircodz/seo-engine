# SEO Intelligence Engine -- example environment configuration.
# Copy to .env and adjust. Every variable is prefixed with SIE_.
# Nested settings use __ as delimiter (e.g. SIE_CRAWLER__MAX_PAGES).

# --- Application -----------------------------------------------------------
SIE_ENVIRONMENT=development
SIE_DEBUG=true
SIE_LOG_LEVEL=INFO
SIE_HOST=127.0.0.1
SIE_PORT=8000

# Production hardening: environment=production automatically forces debug=false,
# disables auto-migrations, and disables localhost outbound crawling.

# --- Persistence -----------------------------------------------------------
SIE_DATABASE_URL=sqlite+aiosqlite:///./sie.db
SIE_DATABASE__POOL_SIZE=5
SIE_DATABASE__MAX_OVERFLOW=10
SIE_DATABASE__POOL_TIMEOUT=30
SIE_DATABASE__POOL_RECYCLE=1800
SIE_DATABASE__AUTO_MIGRATE=true

# --- API authentication ----------------------------------------------------
# Keep disabled for local development. Enable in production and provide one or
# more long random keys. Multiple keys may be supplied as a JSON list.
SIE_API__ENABLED=false
SIE_API__API_KEYS=[]
SIE_API__HEADER_NAME=X-API-Key

# --- Distributed cache ----------------------------------------------------
SIE_CACHE__ENABLED=false
SIE_CACHE__REDIS_URL=redis://127.0.0.1:6379/0
SIE_CACHE__KEY_PREFIX=sie:
SIE_CACHE__RESPONSE_TTL_SECONDS=86400
SIE_CACHE__MAX_MEMORY_ENTRIES=10000
SIE_CACHE__CONNECT_TIMEOUT_SECONDS=2

# --- Durable background jobs ----------------------------------------------
SIE_JOBS__ENABLED=true
SIE_JOBS__POLL_INTERVAL_SECONDS=1
SIE_JOBS__LEASE_SECONDS=300
SIE_JOBS__MAX_ATTEMPTS=3
SIE_JOBS__CONCURRENCY=2

# --- Crawler defaults -----------------------------------------------------
SIE_CRAWLER__USER_AGENT=Mozilla/5.0 (compatible; SEOIntelligenceEngine/0.1)
SIE_CRAWLER__CONNECT_TIMEOUT_SECONDS=5
SIE_CRAWLER__READ_TIMEOUT_SECONDS=20
SIE_CRAWLER__WRITE_TIMEOUT_SECONDS=10
SIE_CRAWLER__POOL_TIMEOUT_SECONDS=5
SIE_CRAWLER__REQUEST_TIMEOUT_SECONDS=20
SIE_CRAWLER__MAX_CONCURRENT_REQUESTS=10
SIE_CRAWLER__RATE_LIMIT_PER_HOST=1.0
SIE_CRAWLER__RESPECT_ROBOTS_TXT=true
SIE_CRAWLER__FOLLOW_CROSS_ORIGIN=false
SIE_CRAWLER__MAX_PAGES=1000
SIE_CRAWLER__DEPTH_LIMIT=5
SIE_CRAWLER__VISITED_CACHE_SIZE=100000
SIE_CRAWLER__MAX_RETRIES=2
SIE_CRAWLER__RETRY_BACKOFF_SECONDS=0.5
SIE_CRAWLER__ALLOW_LOCALHOST=false

# --- Audit engine ---------------------------------------------------------
SIE_AUDIT__ENABLE_P0_RULES=true
SIE_AUDIT__ENABLE_P1_RULES=true
SIE_AUDIT__ENABLE_P2_RULES=false
SIE_AUDIT__MAX_DEPTH_FOR_LINK_ANALYSIS=10
SIE_AUDIT__PAGERANK_DAMPING=0.85
SIE_AUDIT__MAX_ITERATIONS=100
SIE_AUDIT__THRESHOLD_DEAD_END=0
SIE_AUDIT__THRESHOLD_THIN_PAGE=2

# --- Search provider ------------------------------------------------------
SIE_SEARCH_PROVIDER__ENABLED=false
SIE_SEARCH_PROVIDER__PROVIDER_NAME=http
SIE_SEARCH_PROVIDER__BASE_URL=
SIE_SEARCH_PROVIDER__API_KEY=
SIE_SEARCH_PROVIDER__TIMEOUT_SECONDS=30
SIE_SEARCH_PROVIDER__ALLOW_LOCALHOST=false

# --- SerpAPI cost/quota policy -------------------------------------------
SIE_SERPAPI__REQUEST_COST_USD=0
SIE_SERPAPI__MONTHLY_REQUEST_LIMIT=0
SIE_SERPAPI__QUOTA_KEY=serpapi

# --- Google Search Console -----------------------------------------------
SIE_SEARCH_CONSOLE__ENABLED=false
SIE_SEARCH_CONSOLE__PROPERTY_URL=
SIE_SEARCH_CONSOLE__CLIENT_ID=
SIE_SEARCH_CONSOLE__CLIENT_SECRET=
SIE_SEARCH_CONSOLE__REFRESH_TOKEN=
SIE_SEARCH_CONSOLE__ACCESS_TOKEN=
SIE_SEARCH_CONSOLE__TIMEOUT_SECONDS=20

# --- Google Analytics 4 Data API -----------------------------------------
SIE_ANALYTICS__ENABLED=false
SIE_ANALYTICS__PROPERTY_ID=
SIE_ANALYTICS__CLIENT_ID=
SIE_ANALYTICS__CLIENT_SECRET=
SIE_ANALYTICS__REFRESH_TOKEN=
SIE_ANALYTICS__ACCESS_TOKEN=
SIE_ANALYTICS__TIMEOUT_SECONDS=20

# --- Backlinks / DataForSEO ----------------------------------------------
SIE_BACKLINKS__ENABLED=false
SIE_BACKLINKS__PROVIDER_NAME=dataforseo
SIE_BACKLINKS__BASE_URL=https://api.dataforseo.com
SIE_BACKLINKS__LOGIN=
SIE_BACKLINKS__PASSWORD=
SIE_BACKLINKS__TIMEOUT_SECONDS=30
SIE_BACKLINKS__INCLUDE_SUBDOMAINS=true
SIE_BACKLINKS__EXCLUDE_INTERNAL_BACKLINKS=true

# --- LLM provider ---------------------------------------------------------
SIE_LLM__ENABLED=false
SIE_LLM__BASE_URL=https://api.openai.com
SIE_LLM__API_KEY=
SIE_LLM__MODEL=gpt-4o-mini
SIE_LLM__TIMEOUT_SECONDS=60
SIE_LLM__MAX_TOKENS=4096
SIE_LLM__TEMPERATURE=0.3

# --- CrUX -----------------------------------------------------------------
SIE_CRUX__ENABLED=false
SIE_CRUX__API_KEY=
SIE_CRUX__TIMEOUT_SECONDS=10
SIE_CRUX__FORM_FACTOR=PHONE
