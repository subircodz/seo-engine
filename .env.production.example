# Copy to .env.production and replace every placeholder before deployment.
# Never commit the real production file.

SIE_ENVIRONMENT=production
SIE_DEBUG=false
SIE_HOST=0.0.0.0
SIE_PORT=8000
SIE_LOG_LEVEL=INFO

# PostgreSQL. URL-encode special characters in the password.
SIE_DATABASE_URL=postgresql+asyncpg://sie:CHANGE_ME@db:5432/sie
SIE_DATABASE__AUTO_MIGRATE=false
SIE_DATABASE__POOL_SIZE=10
SIE_DATABASE__MAX_OVERFLOW=20
SIE_DATABASE__POOL_TIMEOUT=30
SIE_DATABASE__POOL_RECYCLE=1800

# Protect API routes when they are directly exposed.
SIE_API__ENABLED=true
SIE_API__API_KEYS=CHANGE_ME_TO_A_LONG_RANDOM_KEY
SIE_API__HEADER_NAME=X-API-Key

# Real search provider credentials.
SIE_SEARCH_PROVIDER__ENABLED=true
SIE_SEARCH_PROVIDER__PROVIDER_NAME=serpapi
SIE_SEARCH_PROVIDER__API_KEY=CHANGE_ME
SIE_SEARCH_PROVIDER__ALLOW_LOCALHOST=false

# Safe crawler defaults.
SIE_CRAWLER__ALLOW_LOCALHOST=false
SIE_CRAWLER__RESPECT_ROBOTS_TXT=true
SIE_CRAWLER__FOLLOW_CROSS_ORIGIN=false
SIE_CRAWLER__MAX_REDIRECTS=10
SIE_CRAWLER__MAX_RESPONSE_BYTES=10485760
SIE_CRAWLER__MAX_CONCURRENT_REQUESTS=10
SIE_CRAWLER__RATE_LIMIT_PER_HOST=1.0

# Background jobs run inside the single application process.
SIE_JOBS__ENABLED=true
SIE_JOBS__LEASE_SECONDS=300
SIE_JOBS__MAX_ATTEMPTS=3
SIE_JOBS__CONCURRENCY=2

# Optional distributed cache.
SIE_CACHE__ENABLED=false
SIE_CACHE__REDIS_URL=redis://redis:6379/0

# Optional LLM enhancement.
SIE_LLM__ENABLED=false
SIE_LLM__API_KEY=

# Optional external providers.
SIE_CRUX__ENABLED=false
SIE_SEARCH_CONSOLE__ENABLED=false
SIE_ANALYTICS__ENABLED=false
SIE_BACKLINKS__ENABLED=false
